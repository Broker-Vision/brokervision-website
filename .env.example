# Öffentliche / Build-Zeit Variablen (Frontend)
NEXT_PUBLIC_SITE_URL=https://brokervision.ch

# --- Azure Static Web Apps / Functions Application Settings ---
# Keine echten Secrets in Git committen.

# Cloudflare Turnstile
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=

# Azure Table Storage (Anfragen + Rate-Limit-Zähler)
# Falls leer, wird AzureWebJobsStorage verwendet (sofern vorhanden).
CONTACT_STORAGE_CONNECTION_STRING=
CONTACT_TABLE_NAME=ContactInquiries
CONTACT_IP_HASH_SALT=

# Rate limiting
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX=5

# Microsoft Graph / Microsoft 365 Mail (kein SMTP)
# Aktivierung: CONTACT_MAIL_ENABLED=true setzen, sobald App-Registration bereit ist.
CONTACT_MAIL_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_FROM=info@brokervision.ch
GRAPH_MAIL_TO=info@brokervision.ch
