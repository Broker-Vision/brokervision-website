# Beispiel-Umgebungsvariablen (nicht committen mit echten Werten)
# Für Azure Static Web Apps / Functions Application Settings hinterlegen.

# Optional: Speicherung der Anfragen in Azure Storage
CONTACT_STORAGE_CONNECTION_STRING=

# Optional: Webhook/Notification für E-Mail-Versand (z. B. Logic App / Communication Service)
CONTACT_NOTIFY_WEBHOOK_URL=

# Öffentliche Site-URL (falls benötigt)
NEXT_PUBLIC_SITE_URL=https://brokervision.ch
